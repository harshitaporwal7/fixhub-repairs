# MongoDB connection string (local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fixhub_repairs

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# Demo admin account created by the seed script
ADMIN_EMAIL=admin@fixhubrepairs.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=FixHub Admin
